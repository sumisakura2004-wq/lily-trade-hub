# Public identifiers only; these are intentionally blank.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Server-only Viewer/read token for the private dataset. Never use NEXT_PUBLIC_.
# Do not paste real tokens into code, Studio, Git, or chat.
SANITY_API_READ_TOKEN=

# Optional: leave blank until the company verifies an official WhatsApp URL.
# Configure on the server/Netlify only; never infer a URL from a display name.
COMPANY_VERIFIED_WHATSAPP_URL=
